{
  "name": "akshify",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "rm -rf ./node_modules && rm -rf ./android && rm -rf ./ios && rm -rf ./web-build",
    "apk:dev": "eas build --platform android --profile development",
    "apk:prev": "eas build --platform android --profile preview",
    "apk:prod": "eas build --platform android --profile production",
    "apk:update": "eas update --channel preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
